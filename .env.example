# Copy this file to .env and fill values before deploying.
# IMPORTANT: Do NOT commit .env to source control. Keep secrets secret.

# Telegram
TELEGRAM_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PUT_YOUR_TELEGRAM_CHAT_ID_HERE

# Bot behaviour (defaults are set for 1-minute timeframe monitoring of GOLD and BTCUSD)
TIMEFRAME=60
ASSETS=GOLD,BTCUSD
ALERT_COOLDOWN=30
LOG_FILE=signals_log.csv
TRADE_LOG=backtest_trades.csv
